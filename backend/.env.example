# =============================================================================
# ASPS-DMS backend configuration
#
# Copy to `.env` and fill in locally.  NEVER commit `.env`.
# Every value below is validated at boot by src/config/env.ts; the process
# refuses to start on a bad or missing value rather than failing later.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# -----------------------------------------------------------------------------
# Microsoft SQL Server 2014
#
# REQUIRES COMPANY CONFIRMATION: instance name, host and authentication mode.
# Use either DB_PORT (default 1433) or DB_INSTANCE for a named instance -
# not both. A named instance needs the SQL Server Browser service running.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS
DB_NAME=ASPS_DMS
DB_USER=
DB_PASSWORD=

# SQL Server 2014 with a self-signed certificate, on a trusted LAN.
# Node 20+ ships OpenSSL 3, which rejects the older TLS a stock SQL Server 2014
# offers - see docs/sql-server-2014-notes.md before changing these.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MAX=10
DB_POOL_MIN=0

# -----------------------------------------------------------------------------
# Document storage
#
# Absolute path to the secure storage root on the company server.
# MUST live outside the web root and outside this repository.
# Example (production): D:\ASPS-DMS\Storage
# -----------------------------------------------------------------------------
DOCUMENT_STORAGE_PATH=./.local-storage

# -----------------------------------------------------------------------------
# Sessions
#
# SESSION_SECRET signs the session cookie. Generate a fresh 64-byte value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
SESSION_SECRET=
SESSION_COOKIE_NAME=asps_dms_sid
SESSION_IDLE_TTL_MINUTES=480
SESSION_ABSOLUTE_TTL_HOURS=24

# Set COOKIE_SECURE=true only when the app is served over HTTPS.
# Internal LAN deployments are often plain HTTP, where `true` would silently
# stop the browser from ever sending the session cookie.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# CORS - the Vite dev server origin. In production the frontend is served by
# this same backend, so this can be left empty.
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Uploads and logging
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=25
LOG_LEVEL=debug
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# Document identity check
#
# An uploaded document is read and compared with the employee's own record, so a
# form belonging to one person cannot be filed against another. Which details
# each document type must confirm is configuration, held on the document type.
#
# Reading uses the PDF's own text layer where there is one, and OCR over the
# pages where there is not.
# -----------------------------------------------------------------------------
IDENTITY_CHECK_ENABLED=true
IDENTITY_CHECK_MAX_PAGES=5
IDENTITY_CHECK_TIMEOUT_MS=90000

# OCR language data. Leave these UNSET in development and tesseract.js fetches
# them from a CDN on first use.
#
# ON THE COMPANY SERVER, which has no route to the internet, they must be
# vendored locally or every OCR pass fails - and a document that cannot be read
# cannot be checked. Download eng.traineddata.gz AND hin.traineddata.gz - the
# appointment letter is printed in Hindi, see OCR_LANGUAGES - and the core, put
# them in a folder on the server, and point these at it:
#
#   TESSERACT_LANG_PATH=D:/asps-dms/tesseract
#   TESSERACT_CORE_PATH=D:/asps-dms/tesseract/tesseract-core-simd.wasm.js
#   TESSERACT_CACHE_PATH=D:/asps-dms/tesseract/cache

# -----------------------------------------------------------------------------
# The daily report email
#
# One email, to everybody in REPORT_RECIPIENTS, listing the employees who still
# owe documents and naming those documents. The API sends it itself, once a day
# at REPORT_SEND_TIME on the server's own clock. There is no button anywhere and
# nothing to schedule on the machine.
#
# THERE IS NO ON/OFF SWITCH. It sends when there is somewhere to send to - at
# least one address here and a relay in SMTP_HOST - and does not when there is
# not, which is what a fresh checkout has. Restarting the server does not send a
# second copy of a day that has already gone out.
#
# To see what would go out, or to send one by hand:
#
#   npm run send-reminders -- --dry-run    prints it, sends nothing
#   npm run send-reminders                 sends it now
# -----------------------------------------------------------------------------
REPORT_RECIPIENTS=hr@example.com,accounts@example.com
REPORT_SEND_TIME=09:00

# Off by default. Every new employee starts with ten documents that are not due
# yet, and listing them all from day one makes the digest a copy of the
# checklist. A reminder starts when the document's own date arrives.
REPORT_INCLUDE_NOT_YET_DUE=false

# The company's internal mail relay. SMTP_USER and SMTP_PASSWORD are optional:
# an internal relay commonly accepts mail from the server without credentials,
# and sending an empty auth block to one of those fails the connection.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=asps-dms@aspsinternational.com

# Logs the text a document was read as, but only when a check FAILS.
#
# Off, and meant to stay off outside a developer's machine: it puts the contents
# of an employee's document into a log file, which is the one place this system
# otherwise never puts them. Turn it on to answer "the date is printed right
# there, why was it not found?" - the answer is usually in what OCR returned.
IDENTITY_CHECK_LOG_TEXT=false

# The languages OCR reads, as tesseract.js writes them.
#
# The company's appointment letter is printed in Hindi, and English alone
# returns nothing usable from it. Each language is another model to load and
# ANOTHER FILE TO VENDOR onto the offline server: eng.traineddata AND
# hin.traineddata. Set this to 'eng' for an office with no Hindi paperwork.
OCR_LANGUAGES=eng+hin
# Tried first, before falling back to OCR_LANGUAGES above. Each language model
# is another pass over the page: on the company's PF form 'eng' reads it in 7
# seconds and 'eng+hin' in 15, finding the same name, code and joining date.
# Nine of the ten document types are printed in English. A page the fast pass
# cannot make sense of is read again with the full set, so the Hindi
# appointment letter still reads - it just pays for the extra pass itself.
# Set this equal to OCR_LANGUAGES to switch the two-pass behaviour off.
OCR_PRIMARY_LANGUAGES=eng
