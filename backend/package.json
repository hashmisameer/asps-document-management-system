{
  "name": "@asps-dms/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest tests/unit",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:status": "tsx src/database/cli.ts status",
    "db:check": "tsx src/database/cli.ts check",
    "db:seed": "tsx src/database/cli.ts seed",
    "db:create-user": "tsx src/database/cli.ts create-user",
    "user:add": "tsx src/database/cli.ts create-user",
    "user:reset": "tsx src/database/cli.ts reset-password",
    "user:list": "tsx src/database/cli.ts list-users",
    "send-reminders": "tsx src/scripts/sendReminders.ts",
    "import-employees": "tsx src/scripts/importEmployees.ts"
  },
  "dependencies": {
    "@asps-dms/shared": "*",
    "@napi-rs/canvas": "^0.1.65",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^19.6.0",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mssql": "^9.1.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
